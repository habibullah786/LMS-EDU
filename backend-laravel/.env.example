APP_NAME=LMS-EDU
APP_ENV=local
APP_KEY=base64:test+key=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SURVEY_URL=https://your-site.example.com/trial-survey

ADMIN_NAME="LMS Administrator"
ADMIN_EMAIL=admin@lmsedu.com
ADMIN_PASSWORD=Password123!

LOG_CHANNEL=stack

DB_CONNECTION=sqlite
DB_ENGINE=InnoDB
DB_DATABASE=database/database.sqlite

CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

JWT_SECRET=your-secret-key-here

# Notification services
SENDGRID_API_KEY=your-sendgrid-api-key
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_WEBHOOK_URL=https://your-api.example.com/api/webhooks/twilio/incoming

# Optional Orbund enrollment sync. Leave URL empty to use the admin manual-confirmation fallback.
ORBUND_SYNC_URL=
ORBUND_API_TOKEN=
